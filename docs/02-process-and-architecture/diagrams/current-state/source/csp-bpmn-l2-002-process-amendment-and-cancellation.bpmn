      <intermediateThrowEvent name="RETRY_CANCEL_FILE" id="_12a9a0e2-c1c8-4810-b290-999bd28d1dda">
         <documentation id="documentation_12a9a0e2-c1c8-4810-b290-999bd28d1dda"><![CDATA[Transfers control from a corrected cancellation file-control exception to cancellation import-file preparation and control.]]></documentation>
