      <dataObjectReference id="dataObjectReference_00655fbb-1aa5-46a5-b5ab-cf9b012caee3"
                            name="CSP-IO-007 - Operational lifecycle tracker update"
                            dataObjectRef="_00655fbb-1aa5-46a5-b5ab-cf9b012caee3">
         <documentation id="documentation_00655fbb-1aa5-46a5-b5ab-cf9b012caee3"><![CDATA[Producer: Trade Operations.
Consumer: Relevant operational stakeholders.
Content: Trade and version, lifecycle stage, processing outcome, exception status, owner and next action.
Purpose: Maintains the current operational view used to coordinate lifecycle activity.]]></documentation>
         <extensionElements>
            <adonis:instance>
               <adonis:attribute name="IDENTIFICATION_OF_CHANGES"
                                  type="ENUM"
                                  notebook="1"
                                  sourcelang=""
                                  novalue="0"
                                  lang-independent="v0">
                  <adonis:value>No change</adonis:value>
