                                  type="BOOL"
                                  notebook="1"
                                  sourcelang=""
                                  novalue="0">
                  <adonis:value>false</adonis:value>
                  <adonis:metavalue/>
               </adonis:attribute>
               <adonis:attribute name="A_NEED_FOR_ACTION_CS"
