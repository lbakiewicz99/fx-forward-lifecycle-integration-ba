      <dataStoreReference id="dataStoreReference_0046274a-087d-4ed1-9739-58b57805b559"
                           name="Operational lifecycle tracker"
                           dataStoreRef="_0046274a-087d-4ed1-9739-58b57805b559">
         <documentation id="documentation_0046274a-087d-4ed1-9739-58b57805b559"><![CDATA[Traceability: CSP-PR-004; CSP-PR-005; CSP-ST-002; CSP-ST-007; CSP-PR-008.
 
Owner: Relevant operational teams.
 
Consumers: Trade Operations and Settlement Operations; relevant exception owners and downstream control teams.
 
Content: Trade and accepted version references, currency-leg and instruction identifiers, observed operational statuses, outstanding exceptions, assigned owner, supporting evidence references, applicable cut-off impact, next action and follow-up time.
 
Purpose: Persistent operational record supporting maturity review, settlement preparation, submission reconciliation, settlement monitoring and exception resolution.
 
Usage: Read during population review and updated as preparation, submission, monitoring and recovery progress. Preserve confirmed settled-leg history and distinguish successful settlement from closure through cancellation, recall or recovery.
 
The tracker supports operational coordination. Authoritative instruction and settlement statuses remain in SYS-SET; cash recovery requires the corresponding cash movement evidence.]]></documentation>
         <extensionElements>
            <adonis:instance>
               <adonis:attribute name="IDENTIFICATION_OF_CHANGES"
                                  type="ENUM"
                                  notebook="1"
                                  sourcelang=""
                                  novalue="0"
                                  lang-independent="v0">
                  <adonis:value>No change</adonis:value>
                  <adonis:metavalue/>
               </adonis:attribute>
               <adonis:attribute name="MONITORING"
                                  type="BOOL"
                                  notebook="1"
                                  sourcelang=""
                                  novalue="0">
                  <adonis:value>false</adonis:value>
                  <adonis:metavalue/>
               </adonis:attribute>
               <adonis:attribute name="A_NEED_FOR_ACTION_CS"
                                  type="BOOL"
                                  notebook="1"
                                  sourcelang=""
                                  novalue="0">
                  <adonis:value>false</adonis:value>
                  <adonis:metavalue/>
               </adonis:attribute>
               <adonis:attribute name="FONT_COLOUR"
                                  type="INTEGER"
                                  notebook="0"
                                  sourcelang=""
                                  novalue="0">
                  <adonis:value>0</adonis:value>
                  <adonis:metavalue/>
               </adonis:attribute>
               <adonis:attribute name="CAPACITY"
                                  type="INTEGER"
                                  notebook="1"
                                  sourcelang=""
                                  novalue="0">
                  <adonis:value>0</adonis:value>
                  <adonis:metavalue/>
               </adonis:attribute>
               <adonis:attribute name="AUDITING"
                                  type="BOOL"
                                  notebook="1"
                                  sourcelang=""
                                  novalue="0">
                  <adonis:value>false</adonis:value>
                  <adonis:metavalue/>
               </adonis:attribute>
               <adonis:record name="A_ATTACHMENT_LIST_CS"/>
               <adonis:record name="OPEN_QUESTIONS"/>
            </adonis:instance>
         </extensionElements>
      </dataStoreReference>
      <dataObjectReference id="dataObjectReference_05dcb08a-1cf0-406c-b875-988e56c779be"
                            name="Exception notification and investigation evidence"
                            dataObjectRef="_05dcb08a-1cf0-406c-b875-988e56c779be">
         <documentation id="documentation_05dcb08a-1cf0-406c-b875-988e56c779be"><![CDATA[Traceability: CSP-PR-004; CSP-PR-005; CSP-ST-007; CSP-PR-008.
 
Producer: Settlement Operations.
 
Consumers: Trade Operations, assigned exception owners and relevant operational, accounting and reconciliation teams.
 
Content: Affected trade and version references, currency legs, known instruction identifiers and statuses, investigation findings, communications, attempted corrective or recovery actions, supporting evidence, cut-off impact, outstanding obligations, assigned owner, next action and follow-up time.
 
Purpose: Supports escalation and continued management of unresolved preparation, submission, settlement or recovery exceptions.
 
Preserve confirmed settlement history and distinguish verified outcomes from missing or uncertain information. The notification records ownership and follow-up arrangements; it does not itself confirm successful settlement or completion of recovery.]]></documentation>
         <extensionElements>
            <adonis:instance>
               <adonis:attribute name="IDENTIFICATION_OF_CHANGES"
